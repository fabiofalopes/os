# Coinbase Developer Platform (free at https://cloud.coinbase.com)
CDP_API_KEY_ID=your_cdp_api_key_id
CDP_API_KEY_SECRET=your_cdp_api_key_secret

# OpenAI for AI content generation
OPENAI_API_KEY=your_openai_api_key

# Farcaster (for posting signals)
# Get your FID and signing keys from https://warpcast.com
FARCASTER_FID=your_fid
FARCASTER_MNEMONIC=your_farcaster_mnemonic

# Twitter (optional)
# TWITTER_API_KEY=your_twitter_api_key
# TWITTER_API_SECRET=your_twitter_api_secret
# TWITTER_ACCESS_TOKEN=your_twitter_access_token
# TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Network
NETWORK_ID=base-sepolia

# Posting settings
POST_INTERVAL_MS=1800000  # 30 minutes
POSTING_MODE=free        # free or premium or both

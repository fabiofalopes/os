# Coinbase Developer Platform (free at https://cloud.coinbase.com)
CDP_API_KEY_ID=your_cdp_api_key_id
CDP_API_KEY_SECRET=your_cdp_api_key_secret

# Network: base-sepolia (testnet, free) or base-mainnet
NETWORK_ID=base-sepolia

# Optional: wallet secret for persisted wallet (saved after first run)
# CDP_WALLET_SECRET=your_wallet_secret

# LLM: uses PrimeIntellect by default (PRIME_INTELLECT_API_KEY from ~/.zshrc)
# Override model if needed:
# LLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Or use custom endpoint via upb:
# UPB_LLM_ENDPOINT=http://localhost:8705/v1

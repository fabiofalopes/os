# ── cron-agent-swarm config ──
# Sourced by runner.sh + worker.sh. Every path and model is a parameter — the three
# EDIT-ME lines are the only ones you must touch; the rest are tuning dials.
# Env vars override (handy for dry-runs): WORKSPACE=... AGENT_BIN=... bash runner.sh

# ── EDIT ME ──
# Your workspace = an Obsidian vault or any directory of markdown notes.
WORKSPACE="${WORKSPACE:-/path/to/your/workspace}"
# Absolute path to a headless agent CLI (cron's PATH is /usr/bin:/bin and won't find it).
AGENT_BIN="${AGENT_BIN:-/path/to/claude}"
# Ordered model fallback chain (first that ROUTES wins; space-separated; empty = CLI default).
# Route cheap/free → stronger; if ALL fail, the worker logs ROUTING_FAIL rather than
# silently spending paid quota. Example: "provider/cheap-flash provider/stronger-max".
MODEL_CHAIN="${MODEL_CHAIN:-}"

# Derived paths (override only if you know why)
HARNESS="${HARNESS:-$WORKSPACE/_harness}"
LOG="$WORKSPACE/LOG.md"
QUEUE="$HARNESS/queue.md"

# ── Agent-CLI flag dialect (defaults = Claude Code) ──
# For opencode:  AGENT_RUN_ARGS="run"  AGENT_TURNS_FLAG=""  (opencode has no max-turns
# flag — leave empty and bound by SESSION_TIMEOUT instead) — adapt to your CLI.
# NOTE: the model-fallback cascade keys off is_routing_failure() in worker.sh, which
# greps for Claude Code's "model unavailable" error strings. On another CLI, adapt that
# one grep or a dead model will surface as exit<N> instead of cascading down the chain.
AGENT_RUN_ARGS="-p --dangerously-skip-permissions"   # headless + no interactive prompts
AGENT_TURNS_FLAG="--max-turns"
AGENT_MODEL_FLAG="--model"

# ── Shared substrate (workers READ, never WRITE; snapshot + auto-revert each wave) ──
# Space-separated, workspace-root relative, no spaces in file names.
SUBSTRATE_FILES="INDEX.md MEMORY.md"
# Files the worker is told to read first to orient itself.
ORIENT_FILES="CLAUDE.md MEMORY.md INDEX.md"

# Optional TCP preflight: if the agent CLI routes through a local proxy, set its URL
# (e.g. http://127.0.0.1:8082) — a dead proxy then yields one clean SKIP, not N timeouts.
PREFLIGHT_URL="${PREFLIGHT_URL:-}"

# ── Bounds — the "don't burn tokens" guards ──
MAX_TURNS=40                 # hard cap per session (agent --max-turns)
MAX_SESSIONS_PER_DAY=90      # daily ceiling; runner skips past this (15-min cadence ≈ 96 ticks/day)
SESSION_TIMEOUT=900          # seconds; kill a hung session (15 min)
MAX_JOB_RETRIES=3            # consecutive REAL fails before a job is quarantined [!] and the queue
                             # advances (infra fails — proxy down — never count; those are SKIP lines).

# ── Wave concurrency (one clock, tiered by wave count) ──
WORKERS_PER_TICK=3           # parallel worker sessions per wave (drop to 2 if you see 429s)
WORKER_BUDGET=1200           # HARD outer deadline (s) for a worker's ENTIRE model-fallback loop;
                             # bounds the whole cascade so a wave can't wedge the cron.
BUILDER_EVERY=2              # every Nth wave runs ONE serial "builder" session on a bigger job (0 = off)
BUILDER_MAX_TURNS=80         # builder turn budget (deeper work than a worker's MAX_TURNS)
BUILDER_BUDGET=2400          # builder deadline (s)
COUNCIL_EVERY=4              # every Nth wave runs $HARNESS/council.sh IF IT EXISTS (0 = off; bring your own)
REFLECT_EVERY=21600          # empty-queue self-review throttle (s; default 6h)

# Lock (prevents overlapping runs)
LOCKFILE="$HARNESS/state/runner.lock"

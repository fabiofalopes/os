filters:
  and:
    - file.ext == "md"
    - file.name != "LOG.md"
views:
  - type: table
    name: RootFlat
    filters:
      and:
        - file.inFolder("/")
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 30
  - type: table
    name: InboxTransient
    filters:
      and:
        - file.inFolder("inbox")
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 30
  - type: table
    name: MOCs
    filters:
      and:
        - or:
            - file.inFolder("wiki/research")
            - file.inFolder("wiki/value")
            - file.inFolder("_harness")
            - file.inFolder("quant")
    order:
      - file.name
      - file.folder
      - file.mtime
    limit: 20
  - type: table
    name: MetaProposals
    filters:
      and:
        - file.inFolder("_meta")
    order:
      - file.name
      - file.mtime
    limit: 20

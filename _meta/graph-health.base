filters:
  and:
    - file.ext == "md"
    - 'file.name != "LOG.md"'
views:
  - type: table
    name: RootFlat
    limit: 30
    filters:
      and:
        - file.inFolder("/")
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: InboxTransient
    limit: 30
    filters:
      and:
        - file.inFolder("inbox")
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: MOCs
    limit: 20
    filters:
      and:
        - or:
            - file.inFolder("wiki/research")
            - file.inFolder("wiki/value")
            - file.inFolder("_harness")
            - file.inFolder("quant")
    order:
      - file.name
      - file.folder
      - file.mtime
  - type: table
    name: MetaProposals
    limit: 20
    filters:
      and:
        - file.inFolder("_meta")
    order:
      - file.name
      - file.mtime

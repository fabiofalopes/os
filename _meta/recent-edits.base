filters:
  and:
    - file.ext == "md"
    - file.name != "LOG.md"
views:
  - type: table
    name: Latest
    filters:
      and:
        - file.mtime > now() - "2 weeks"
    order:
      - file.name
      - file.folder
      - file.mtime
  - type: table
    name: Inbox
    filters:
      and:
        - file.inFolder("inbox")
    order:
      - file.name
      - file.mtime
    limit: 20
  - type: table
    name: WikiQuant
    filters:
      and:
        - or:
            - file.inFolder("wiki")
            - file.inFolder("quant")
    order:
      - file.name
      - file.folder
      - file.mtime
    limit: 20
  - type: table
    name: Harness
    filters:
      and:
        - or:
            - file.inFolder("_harness")
            - file.inFolder("journal")
    order:
      - file.name
      - file.folder
      - file.mtime
    limit: 20

# ── The Forge harness config ──
# Sourced by runner.sh. Edit these to tune the engine.

# Vault + harness paths
VAULT="/home/fabio/obsidian-vault-kali"
HARNESS="$VAULT/_harness"
LOG="$VAULT/LOG.md"
QUEUE="$HARNESS/queue.md"

# Absolute path to the claude binary — cron's PATH is /usr/bin:/bin and won't find it otherwise.
CLAUDE_BIN="/home/fabio/.npm-global/bin/claude"

# Ordered model fallback chain (first that ROUTES wins; space-separated).
# Claude-Code-compatible only — opencode/* models do NOT route through Claude Code.
# qwen3.8-max-preview is effectively FREE during the Alibaba preview window (smash it).
# Cascade: free-preview -> cheap-flash -> stronger-max. If ALL fail, the runner logs
# ROUTING_FAIL rather than silently burning paid quota — fix forward, don't spend.
# (To allow paid claude-default as a last resort, append an empty "" entry at the end.)
MODEL_CHAIN="alibaba-token-plan/qwen3.8-max-preview alibaba-token-plan/qwen3.6-flash alibaba-token-plan/qwen3.7-max"

# Bounds — the "don't burn tokens" guards
MAX_TURNS=40                 # hard cap per session (claude --max-turns)
MAX_SESSIONS_PER_DAY=90      # daily ceiling; runner skips past this (15-min cadence ≈ 96 ticks/day)
SESSION_TIMEOUT=900          # seconds; kill a hung session (15 min)
MAX_JOB_RETRIES=3            # consecutive REAL fails before a job is quarantined [!] and the queue
                             # advances (infra fails — proxy down — don't count). META-REVIEW triages [!].
MAX_JOB_RETRIES=3            # consecutive REAL fails before a job is quarantined [!] and the queue
                             # advances (infra fails — proxy down — never count; those are SKIP lines)

# Lock (prevents overlapping runs)
LOCKFILE="$HARNESS/state/runner.lock"

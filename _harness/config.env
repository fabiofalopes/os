# ── The Forge harness config ──
# Sourced by runner.sh. Edit these to tune the engine.

# Vault + harness paths
VAULT="/home/fabio/obsidian-vault-kali"
HARNESS="$VAULT/_harness"
LOG="$VAULT/LOG.md"
QUEUE="$HARNESS/queue.md"

# Absolute path to the claude binary — cron's PATH is /usr/bin:/bin and won't find it otherwise.
CLAUDE_BIN="/home/fabio/.npm-global/bin/claude"

# Ordered model fallback chain (first that ROUTES wins; space-separated).
# Claude-Code-compatible only — opencode/* models do NOT route through Claude Code.
# qwen3.8-max-preview is effectively FREE during the Alibaba preview window (smash it).
# Cascade: free-preview -> cheap-flash -> stronger-max. If ALL fail, the runner logs
# ROUTING_FAIL rather than silently burning paid quota — fix forward, don't spend.
# (To allow paid claude-default as a last resort, append an empty "" entry at the end.)
MODEL_CHAIN="alibaba-token-plan/qwen3.8-max-preview alibaba-token-plan/qwen3.6-flash alibaba-token-plan/qwen3.7-max"

# Bounds — the "don't burn tokens" guards
MAX_TURNS=40                 # hard cap per session (claude --max-turns)
MAX_SESSIONS_PER_DAY=90      # daily ceiling; runner skips past this (15-min cadence ≈ 96 ticks/day)
SESSION_TIMEOUT=900          # seconds; kill a hung session (15 min)
MAX_JOB_RETRIES=3            # consecutive REAL fails before a job is quarantined [!] and the queue
                             # advances (infra fails — proxy down — never count; those are SKIP lines).
                             # META-REVIEW triages [!]. (2026-07-21: duplicate line removed by META-REVIEW #1)
GATEWAY_HOLD_S=1800          # seconds the gateway-502 breaker hold lasts (Guard 5, FM-7). On a 502
                             # storm signature in worker output (gateway_detect) or a 5xx active probe
                             # (gateway_probe), waves exit on a cheap SKIP(GATEWAY) until expiry. Bursts
                             # observed ~5 min (2026-07-28); a short hold self-clears fast. FM-3 mirror.
GATEWAY_PROBE=1              # active pre-dispatch probe (Guard 5b): an authenticated POST /v1/messages
                             # (max_tokens=1) exercising the router's UPSTREAM fetch — the only probe that
                             # fails when the router is listening but its upstream is dead (GET /v1/models
                             # is served locally and stayed 200 throughout the 07-28 storm — FM-7 gap (b)).
                             # Cost ~1 output token + 1–2s per healthy wave. Flip to 0 to disable.
GATEWAY_FLAP=1               # FM-10 (W-2) flap memory for the 502 breaker: ≥2 holds inside
                             # GATEWAY_FLAP_WINDOW_S escalate the hold ×2 per in-window repeat, capped at
                             # GATEWAY_FLAP_CAP_MULT × GATEWAY_HOLD_S (30m → 60m → 120m → 120m…), and write
                             # state/gateway_flap_alert, which oracle.sh surfaces as ONE line on the human's
                             # screen — Guard-5 is correct but SILENT, and a 90-min stall skips ~3 builder
                             # waves with nothing saying why (07-29 + 08-01 flaps: hold→expire→probe-502→
                             # re-latch ~9s after RESUMED, ~45-min period). Counter resets on a clean
                             # authenticated probe (recovery) or an out-of-window latch. The runner writes
                             # ONLY LOG/queue/state — the alert is marker-rendered by oracle.sh, never
                             # appended to hand-maintained _ORACLE-CURATED.md. Flip to 0 → fixed GATEWAY_HOLD_S
                             # hold, no counter, no marker (pre-fix), never a wedge.
GATEWAY_FLAP_WINDOW_S=21600  # seconds two holds must be closer than to count as a flap (6h — a persistent
                             # outage flaps every ~45 min on the fixed hold; isolated bursts hours apart stay
                             # single fixed holds and never alert).
GATEWAY_FLAP_CAP_MULT=4      # escalating-hold multiplier cap: hold = GATEWAY_HOLD_S × min(2^(count−1), cap)
                             # → 1800/3600/7200s. Caps recovery-detection latency at 2h — the probe is ~free,
                             # so escalation buys log quiet + the human-visible alert, not token savings.
DEFERRED_HOLD_S=3600         # seconds the deferred re-dispatch hold lasts (Guard 6, FM-8 follow-up). A job
                             # returning ok(DEFERRED) has a precondition NO cron wave can change, yet until this
                             # breaker it was re-dispatched every wave to re-check it — ROW-4 step-2 deferred 41×
                             # on the ~30-min builder cadence (33–1958s a head), the no-op burn that fed the
                             # 07-30 quota exhaust → ~26h dark. On ok(DEFERRED) the runner latches the job +
                             # expiry epoch in _harness/.deferred_hold; until expiry that SAME job is not
                             # re-dispatched. PER-JOB, not global (the FM-4 lesson): if it is the sole unchecked
                             # candidate the wave exits on a cheap SKIP(DEFERRED_HOLD); otherwise runnable
                             # siblings still dispatch and only the held job is skipped. Corrupt hold self-heals.
TIMEOUT_PROMOTE=1            # FM-9 first-timeout builder promotion: a job whose FIRST worker-lane attempt ended
                             # in a bare TIMEOUT is retried on the BUILDER lane (BUILDER_BUDGET cap) — decided
                             # mechanically from LOG verdict history (worker_timeout_promote), never from job-text
                             # keywords (the FM-4b lesson). The first 900s TIMEOUT is already the evidence the job
                             # is too big for the worker lane; paying a second 900s to relearn it is pure burn
                             # (2026-07-31: the FM-8-follow-up job burned 2×900s on workers before the builder lane
                             # did the SAME job in 1595s — 3rd recurrence of the FM-5 pattern). Builder-lane
                             # timeouts still count toward MAX_JOB_RETRIES quarantine — promotion buys headroom,
                             # not immunity. Flip to 0 to disable (retries revert to the worker lane).
                             # SESSION_TIMEOUT untouched — it guards the FM-2 trust-bug hang.

# ── Wave concurrency (the "agentic village" — one 15-min clock, tiered by wave count) ──
WORKERS_PER_TICK=3           # parallel worker sessions per wave (raised 2->3 on 2026-07-21 after clean router journal; drop to 2 if 429s appear)
                             # watching `journalctl --user -u universal-router` for 429s for a few days.
WORKER_BUDGET=1200           # HARD outer deadline (s) for a worker's ENTIRE model-fallback loop. Per-model
                             # SESSION_TIMEOUT (900) bounds one hung model; this bounds the whole cascade so
                             # a wave can't wedge the cron. Kept above the observed ~10.5-min max session.
BUILDER_EVERY=2              # every Nth wave runs ONE serial "builder" session on a bigger job (0 = off)
BUILDER_MAX_TURNS=80         # builder turn budget (deeper work than a worker's MAX_TURNS)
BUILDER_BUDGET=2400          # builder deadline (s)
BUILDER_ROUTE_PATTERN='^\[Quant\][^:]*EXECUTE'
                             # ERE (case-sensitive) auto-routing jobs to the builder lane instead of the worker
                             # lane, so data-heavy jobs don't double-timeout at SESSION_TIMEOUT (900s). Workers
                             # SKIP matching jobs in the claim loop; the builder wave picks them up first. An
                             # explicit '[builder]' tag routes to builder ONLY as a leading token (bare, or right
                             # after the [Role] prefix) — a tag merely quoted in the job body does NOT route
                             # (2026-07-27: anchored to stop substring mis-routing that deadlocked the lane).
                             # Default catches [Quant] EXECUTE jobs: the ROW-3 pilot burned 2×900s on workers,
                             # then ran in 741s on the builder (LOG 2026-07-26T14:30/14:45/14:57Z). Empty string
                             # = tag-only routing. Tune carefully — a loose pattern mis-routes: the ^\[Quant\]
                             # anchor is what keeps '[Critic] … before the EXECUTE job' on the worker lane.
COUNCIL_EVERY=4              # every Nth wave (~hourly) runs the council (0 = off)
COUNCIL_ENABLED=0            # ship OFF; flip to 1 only after the COUNCIL-AUDIT A/B machinery is proven
COUNCIL_INPUT_LINES=40       # recent LOG.md lines fed to each council member (~last hour)

# Lock (prevents overlapping runs)
LOCKFILE="$HARNESS/state/runner.lock"
